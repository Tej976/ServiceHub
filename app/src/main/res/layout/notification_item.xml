<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@android:color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/notification_card_bg">

        <!-- Read/Unread Indicator -->
        <View
            android:id="@+id/notificationReadIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:background="@drawable/notification_indicator"
            android:elevation="2dp"
            android:tag="read" />

        <!-- Notification Title -->
        <TextView
            android:id="@+id/textViewNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/notificationReadIndicator"
            android:text="Notification Title"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Notification Message -->
        <TextView
            android:id="@+id/textViewNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewNotificationTitle"
            android:layout_toEndOf="@id/notificationReadIndicator"
            android:layout_marginTop="4dp"
            android:text="Notification message goes here. This can be a longer description."
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/textViewNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewNotificationMessage"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:text="Apr 30, 2025 10:30"
            android:textColor="#888888"
            android:textSize="12sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>