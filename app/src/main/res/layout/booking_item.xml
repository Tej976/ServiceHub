<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iconBookingType"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_providing_service"
            android:contentDescription="Booking type indicator" />

        <TextView
            android:id="@+id/textViewProviderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconBookingType"
            android:layout_alignParentTop="true"
            android:text="Provider Name"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewRoleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="You are providing"
            android:textSize="12sp"
            android:textColor="@color/colorAccent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewServiceType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewProviderName"
            android:layout_marginTop="4dp"
            android:layout_marginStart="32dp"
            android:text="Service Type"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewServiceType"
            android:layout_marginTop="4dp"
            android:layout_marginStart="32dp"
            android:text="Date and Time"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewDateTime"
            android:layout_marginTop="8dp"
            android:layout_alignParentEnd="true"
            android:text="Status"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Hidden TextView to store booking ID -->
        <TextView
            android:id="@+id/textViewBookingId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>